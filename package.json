{
  "name": "block-ops-tactical-drift",
  "version": "1.0.0",
  "description": "BLOCK OPS: TACTICAL DRIFT - 5v5 voxel tactical shooter (Node.js + Socket.io + WebGL2)",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:mobile": "node scripts/build-mobile.js",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "test": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "socket.io-client": "^4.8.1"
  }
}
